# Copy this to .env (same folder as package.json, NOT inside src/).
# Vite only exposes env vars prefixed with VITE_ to the browser — this
# is not a secret, it's just the URL the frontend calls for API requests.

# Local dev: your backend running via `npm run dev` inside server/
VITE_API_URL="http://localhost:4000"

# On your phone, over the same WiFi as your laptop, localhost means
# "this phone" — use your laptop's LAN IP instead, e.g.:
# VITE_API_URL="http://192.168.1.42:4000"
