# Copy this to .env and fill in real values. Never commit .env itself.

# Local dev: postgresql://postgres:postgres@localhost:5432/pulse
# Railway: use the DATABASE_URL Railway generates for your Postgres plugin
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulse"

# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000

# Comma-separated list of origins allowed to call this API — your
# deployed frontend's URL(s) in production, http://localhost:5173 for
# local Vite dev.
CORS_ORIGIN="http://localhost:5173"

# Set to production on the live server. Turns on the safety checks at boot
# (JWT_SECRET of 32+ characters and CORS_ORIGIN are then mandatory).
NODE_ENV=development

# How many proxies sit in front of the API (Railway = 1). Leave unset to use
# 1 in production and 0 locally.
# TRUST_PROXY=1

# Optional rate-limit tuning (defaults shown)
# SIGNUP_RATE_LIMIT=20
# API_RATE_LIMIT=3000

# Encrypts admins' two-factor secrets in the database. Use a DIFFERENT random
# value from JWT_SECRET in production.
# TOTP_ENCRYPTION_KEY=

# Encrypts KYC document images in the database. Use its own random value in
# production and BACK IT UP: without it, stored images cannot be opened.
# KYC_ENCRYPTION_KEY=

# Login cookie. lax = site and API on the same site (default, recommended).
# none = site and API on unrelated domains (HTTPS only, may be blocked by browsers).
# COOKIE_SAMESITE=lax

# 1 = this server also serves the built website (build it first with
# VITE_API_URL=same-origin). Lets you deploy everything on ONE address.
# SERVE_FRONTEND=0

# ---- Email (verification codes, forgotten password) ----
# Local testing: leave EMAIL_PROVIDER unset. Emails are printed in this server's
# log instead of being sent. For real sending you need a domain verified with
# the provider.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Pulse <noreply@yourdomain.com>
# 1 = deposits/withdrawals need a verified email (turn on once email delivery works)
# REQUIRE_VERIFIED_EMAIL=0

# 1 = every admin MUST turn on two-factor login. Until they do, an admin can only
# reach Settings (to set it up). Set up YOUR OWN two-factor first, then switch this on.
# REQUIRE_ADMIN_2FA=0
